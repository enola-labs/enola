{
  "repo": "go_sample",
  "snapshot": {
    "generated_at": "<TIME>"
  },
  "constraints_declared": true,
  "targets": [
    {
      "target": "pkg/b.Beta",
      "kind": "symbol",
      "measured": true,
      "components": [
        {
          "component": "pkg-b",
          "source": "enola-intent.yaml",
          "rules": [
            {
              "rule": "a-avoids-b",
              "statement": "pkg-a must not reach pkg-b via imports",
              "because": "a must stay deliverable without b",
              "mode": "ratchet",
              "source": "enola-intent.yaml"
            }
          ]
        }
      ],
      "no_rule_governs": false,
      "blast_radius": {
        "fan_in": 2,
        "fan_out": 1,
        "in": [
          "..main",
          "pkg/a.Alpha"
        ],
        "out": [
          "pkg/a.Alpha"
        ]
      }
    }
  ]
}